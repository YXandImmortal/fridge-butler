# 本文件为后端本地开发环境变量模板，可提交到 Git。
# 复制为 .env 后填写；.env 已在 backend/.gitignore 中忽略。

# MySQL（application-dev.yaml）
DB_USERNAME=root
DB_PASSWORD=

# JWT。JWT_SECRET 至少 32 字节，建议使用 64 字节以上的随机值。
# 过期时间单位为毫秒：1 天 = 86400000，30 天 = 2592000000。
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REMEMBER_ME_EXPIRATION=2592000000

# AI。DEEPSEEK_API_KEY 用作旧配置回退。
# AI_CONFIG_SECRET 用于加密后台填写的 API 密钥，必须是 Base64 编码的 32 字节随机密钥。
# 可在 Git Bash 中执行 openssl rand -base64 32 生成。
DEEPSEEK_API_KEY=
AI_CONFIG_SECRET=

# SMTP 邮件服务。MAIL_PASSWORD 通常填写邮件服务商提供的授权码，而非登录密码。
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PROTOCOL=smtp

# 超级管理员首次初始化。
# 初始随机密码写入 ADMIN_CREDENTIALS_DIR/admin-credentials.txt；
# 目录留空时写入系统临时目录下的 fridge-butler/admin-credentials.txt。
ADMIN_USERNAME=admin
ADMIN_CREDENTIALS_DIR=

# 图形验证码。默认开启；仅 dev 环境允许设为 false 用于本地自动化测试，生产环境强制开启。
# 关闭后前端可固定填写四位 TEST，邮件验证码不受影响。
CAPTCHA_ENABLED=true

# 跨域来源与历史徽章补发开关，以下为开发默认值。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://10.0.2.2:8081
BADGE_RETROFIT_ENABLED=false
